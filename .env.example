# 复制为 .env 并填写。密钥勿提交 Git。

TRANSLATE_API_BASE=https://apihub.agnes-ai.com/v1
TRANSLATE_API_KEY=
TRANSLATE_MODEL=agnes-2.5-flash

# 分场景模型（留空则用 TRANSLATE_MODEL）
TEXT_MODEL=
IMAGE_MODEL=
VIDEO_MODEL=agnes-video-v2.0
GAME_MODEL=

# 本地 Ollama（设置页可切换 use_local）
LOCAL_MODEL=qwen2.5:7b-instruct

# 项目内 ffmpeg：把 ffmpeg.exe 放到 tools/ffmpeg/bin/
FFMPEG_DIR=tools/ffmpeg/bin

# HuggingFace 镜像（faster-whisper）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
# WHISPER_MODEL=small
